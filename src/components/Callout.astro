---
interface Props {
  type?: 'tip' | 'warning' | 'quote' | 'summary' | 'note';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const icons = {
  tip: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>',
  warning: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
  quote: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>',
  summary: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>',
  note: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4"/><path d="M12 16h.01"/><circle cx="12" cy="12" r="10"/></svg>',
};

const defaultTitles = {
  tip: 'Tip',
  warning: 'Warning',
  quote: 'Quote',
  summary: 'Summary',
  note: 'Note',
};
---

<aside class:list={['callout', `callout-${type}`]} role="note">
  <div class="callout-header">
    <span class="callout-icon">
      <Fragment set:html={icons[type]} />
    </span>
    <span class="callout-title">{title || defaultTitles[type]}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: var(--space-8) 0;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border-left: 4px solid;
  }
  
  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  
  .callout-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .callout-title {
    font-weight: 600;
    font-size: var(--text-base);
  }
  
  .callout-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  
  .callout-content :global(p) {
    margin: 0;
  }
  
  .callout-content :global(p + p) {
    margin-top: var(--space-3);
  }
  
  /* Tip */
  .callout-tip {
    background-color: rgba(16, 185, 129, 0.1);
    border-color: #10b981;
  }
  
  .callout-tip .callout-icon,
  .callout-tip .callout-title {
    color: #10b981;
  }
  
  [data-theme="dark"] .callout-tip {
    background-color: rgba(16, 185, 129, 0.15);
  }
  
  /* Warning */
  .callout-warning {
    background-color: rgba(245, 158, 11, 0.1);
    border-color: #f59e0b;
  }
  
  .callout-warning .callout-icon,
  .callout-warning .callout-title {
    color: #f59e0b;
  }
  
  [data-theme="dark"] .callout-warning {
    background-color: rgba(245, 158, 11, 0.15);
  }
  
  /* Quote */
  .callout-quote {
    background-color: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
  }
  
  .callout-quote .callout-icon,
  .callout-quote .callout-title {
    color: #8b5cf6;
  }
  
  [data-theme="dark"] .callout-quote {
    background-color: rgba(139, 92, 246, 0.15);
  }
  
  /* Summary */
  .callout-summary {
    background-color: rgba(34, 197, 94, 0.1);
    border-color: #22c55e;
  }
  
  .callout-summary .callout-icon,
  .callout-summary .callout-title {
    color: #22c55e;
  }
  
  [data-theme="dark"] .callout-summary {
    background-color: rgba(34, 197, 94, 0.15);
  }
  
  /* Note */
  .callout-note {
    background-color: rgba(37, 99, 235, 0.1);
    border-color: #2563eb;
  }
  
  .callout-note .callout-icon,
  .callout-note .callout-title {
    color: #2563eb;
  }
  
  [data-theme="dark"] .callout-note {
    background-color: rgba(37, 99, 235, 0.15);
  }
</style>
