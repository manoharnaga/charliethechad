---
/**
 * BookPageHero - Conversion-focused book landing hero.
 *
 * Semantic <article> with a two-column <header> (cover left, metadata right),
 * a single H1, italic tagline, keyword-rich description, a lightweight icon
 * metadata row, one high-emphasis primary CTA, and the data-driven
 * "Available Worldwide" retailer grid + "Community & Reviews" section.
 */

import BookBadge from './BookBadge.astro';
import BookRetailers from './BookRetailers.astro';

interface Props {
  title: string;
  description: string;
  tagline?: string;
  coverImage: string;
  publishDate?: Date;
  badge?: string;
  status?: 'upcoming' | 'available' | 'bestseller';
  previewLink?: string;
  amazonLink?: string;
  goodreadsLink?: string;
  retailers?: Record<string, string | undefined>;
  pageCount?: number;
  readingTime?: number;
  language?: string;
  formats?: string[];
  genres?: string[];
}

const {
  title,
  description,
  tagline,
  coverImage,
  publishDate,
  badge = 'New Release',
  status = 'available',
  previewLink,
  amazonLink,
  goodreadsLink,
  retailers = {},
  pageCount,
  readingTime,
  language = 'English',
  formats = [],
  genres = [],
} = Astro.props;

const formattedDate = publishDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const badgeVariant = {
  'upcoming': 'coming-soon',
  'available': 'new-release',
  'bestseller': 'bestseller',
}[status] as 'new-release' | 'bestseller' | 'coming-soon';

// Merge legacy single-link fields into the data-driven retailers object so
// older book files keep working without edits.
const effectiveRetailers: Record<string, string | undefined> = { ...retailers };
if (!effectiveRetailers.amazon && amazonLink) effectiveRetailers.amazon = amazonLink;
if (!effectiveRetailers.goodreads && goodreadsLink) effectiveRetailers.goodreads = goodreadsLink;

const readTimeLabel = readingTime
  ? `${readingTime} min read`
  : pageCount
    ? `${pageCount} pages`
    : null;
const formatsLabel = formats.length > 0 ? formats.join(' \u00B7 ') : null;
const previewCtaLabel = status === 'upcoming' ? 'Read Sample' : 'Read Free Preview';
---

<article class="book-hero">
  <div class="hero-bg-pattern" aria-hidden="true"></div>

  <div class="hero-container">
    <header class="hero-header">
      <!-- Cover (left) -->
      <div class="hero-cover">
        <div class="cover-frame">
          <img
            src={coverImage}
            alt={`Front cover of the book "${title}"`}
            width="320"
            height="427"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>

      <!-- Metadata (right) -->
      <div class="hero-info">
        <div class="hero-badge">
          <BookBadge variant={badgeVariant} text={badge} size="lg" />
        </div>

        <h1 class="hero-title">{title}</h1>

        {tagline && <p class="hero-tagline">{tagline}</p>}

        <p class="hero-description">{description}</p>

        <ul class="hero-meta" aria-label="Book details">
          {formattedDate && (
            <li class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                <line x1="16" x2="16" y1="2" y2="6" />
                <line x1="8" x2="8" y1="2" y2="6" />
                <line x1="3" x2="21" y1="10" y2="10" />
              </svg>
              <span>{formattedDate}</span>
            </li>
          )}

          {readTimeLabel && (
            <li class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
              </svg>
              <span>{readTimeLabel}</span>
            </li>
          )}

          {language && (
            <li class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span>{language}</span>
            </li>
          )}

          {formatsLabel && (
            <li class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
              <span>{formatsLabel}</span>
            </li>
          )}
        </ul>

        {genres.length > 0 && (
          <ul class="hero-genres" aria-label="Genres">
            {genres.map((genre) => (
              <li class="genre-chip">{genre}</li>
            ))}
          </ul>
        )}

        {previewLink && (
          <div class="hero-cta">
            <a href={previewLink} class="cta-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                <path d="M8 7h6" />
                <path d="M8 11h8" />
              </svg>
              {previewCtaLabel}
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- Data-driven store grid + community/reviews -->
    <BookRetailers retailers={effectiveRetailers} bookTitle={title} />
  </div>
</article>

<style>
  .book-hero {
    position: relative;
    padding: var(--space-16) 0;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 0% 50%, rgba(37, 99, 235, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 100% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 100%, rgba(37, 99, 235, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  [data-theme='dark'] .hero-bg-pattern {
    background:
      radial-gradient(ellipse at 0% 50%, rgba(37, 99, 235, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse at 100% 0%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 100%, rgba(37, 99, 235, 0.1) 0%, transparent 50%);
  }

  .hero-container {
    position: relative;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Two-column header */
  .hero-header {
    display: grid;
    gap: var(--space-12);
    align-items: center;
    margin-bottom: var(--space-16);
  }

  @media (min-width: 768px) {
    .hero-header {
      grid-template-columns: 340px 1fr;
      gap: var(--space-16);
    }
  }

  /* Cover */
  .hero-cover {
    display: flex;
    justify-content: center;
  }

  .cover-frame {
    width: 280px;
    max-width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.05),
      -20px 20px 40px rgba(0, 0, 0, 0.15);
    transform: rotateY(-5deg);
    transition: transform var(--transition-base);
  }

  .cover-frame:hover {
    transform: rotateY(0deg);
  }

  .cover-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .cover-frame {
      width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-frame {
      transform: none;
    }
  }

  /* Info column */
  .hero-info {
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-info {
      text-align: left;
    }
  }

  .hero-badge {
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .hero-tagline {
    font-size: var(--text-xl);
    color: var(--color-accent);
    font-style: italic;
    margin-bottom: var(--space-5);
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 560px;
  }

  @media (min-width: 768px) {
    .hero-description {
      margin-left: 0;
      margin-right: auto;
    }
  }

  /* Metadata row */
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-meta {
      justify-content: flex-start;
    }
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .meta-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Genre chips */
  .hero-genres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-genres {
      justify-content: flex-start;
    }
  }

  .genre-chip {
    padding: var(--space-1) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  /* Single high-emphasis CTA */
  .hero-cta {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-cta {
      justify-content: flex-start;
    }
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    color: #fff;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(37, 99, 235, 0.45);
    color: #fff;
  }

  .cta-primary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-primary:hover {
      transform: none;
    }
  }
</style>
