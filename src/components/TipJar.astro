---
/**
 * TipJar - A cute "Leave me a tip" card shown at the end of each blog post.
 *
 * Features a friendly cats illustration and a PayPal QR code so readers can
 * scan and tip in a couple of taps. Purely presentational, no client JS.
 */

interface Props {
  /** PayPal (or any) tip link — used as a clickable fallback under the QR. */
  tipLink?: string;
  qrImage?: string;
  catsImage?: string;
}

const {
  tipLink = 'https://www.paypal.com/paypalme/',
  qrImage = '/images/paypal_cuteCat_QR_forTips.png',
  catsImage = '/images/cutecats_for_tips.png',
} = Astro.props;
---

<aside class="tip-jar" aria-labelledby="tip-jar-heading">
  <div class="tip-jar-inner">
    <div class="tip-jar-cats">
      <img src={catsImage} alt="Two cute cats saying thank you" loading="lazy" width="220" height="220" />
      <span class="tip-jar-paws" aria-hidden="true">🐾</span>
    </div>

    <div class="tip-jar-body">
      <span class="tip-jar-kicker">Enjoyed the read?</span>
      <h3 id="tip-jar-heading" class="tip-jar-title">
        Leave me a tip <span aria-hidden="true">☕️💛</span>
      </h3>
      <p class="tip-jar-text">
        These stories are free and always will be. If one made you think, smile,
        or feel a little less alone, a small tip helps me (and the cats) keep
        writing. Every bit means the world.
      </p>
      <span class="tip-jar-hint">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          <path d="M14 14h3v3"></path>
          <path d="M21 21v.01"></path>
          <path d="M17 21h-3v-3"></path>
        </svg>
        Scan the QR to tip via PayPal
      </span>
    </div>

    <div class="tip-jar-qr">
      <a href={tipLink} target="_blank" rel="noopener noreferrer" aria-label="Tip me via PayPal">
        <img src={qrImage} alt="PayPal QR code to leave a tip" loading="lazy" width="180" height="180" />
      </a>
      <span class="tip-jar-qr-caption">Point your camera here 💫</span>
    </div>
  </div>
</aside>

<style>
  .tip-jar {
    max-width: var(--max-width-prose);
    margin: var(--space-16) auto 0;
    padding: 0 var(--space-6);
  }

  .tip-jar-inner {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 182, 193, 0.22), transparent 55%),
      radial-gradient(120% 140% at 100% 100%, rgba(255, 214, 165, 0.28), transparent 55%),
      var(--color-bg-alt);
    border: 1.5px dashed var(--color-border);
    overflow: hidden;
  }

  [data-theme='dark'] .tip-jar-inner {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 120, 150, 0.14), transparent 55%),
      radial-gradient(120% 140% at 100% 100%, rgba(255, 180, 120, 0.14), transparent 55%),
      var(--color-bg-elevated);
  }

  /* Cats illustration */
  .tip-jar-cats {
    position: relative;
    flex-shrink: 0;
  }

  .tip-jar-cats img {
    width: 120px;
    height: auto;
    border-radius: var(--radius-lg);
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.12));
    animation: tip-bob 4s ease-in-out infinite;
  }

  .tip-jar-paws {
    position: absolute;
    top: -10px;
    right: -6px;
    font-size: 20px;
    transform: rotate(12deg);
  }

  /* Body copy */
  .tip-jar-body {
    min-width: 0;
  }

  .tip-jar-kicker {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .tip-jar-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
  }

  .tip-jar-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .tip-jar-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .tip-jar-hint svg {
    color: var(--color-accent);
  }

  /* QR code */
  .tip-jar-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .tip-jar-qr a {
    display: block;
    padding: var(--space-3);
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tip-jar-qr a:hover {
    transform: translateY(-3px) rotate(-1deg);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.18);
  }

  .tip-jar-qr img {
    width: 128px;
    height: 128px;
    display: block;
    border-radius: var(--radius-sm);
  }

  .tip-jar-qr-caption {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  @keyframes tip-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Tablet */
  @media (max-width: 720px) {
    .tip-jar-inner {
      grid-template-columns: auto 1fr;
      gap: var(--space-5);
    }

    .tip-jar-qr {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: center;
      gap: var(--space-4);
      padding-top: var(--space-2);
      border-top: 1px dashed var(--color-border);
    }
  }

  /* Phone */
  @media (max-width: 480px) {
    .tip-jar-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: var(--space-6);
    }

    .tip-jar-hint {
      justify-content: center;
    }

    .tip-jar-cats img {
      width: 96px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tip-jar-cats img {
      animation: none;
    }
  }
</style>
