---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config/site';

const milestones = SITE.author.milestones;
const stats = SITE.author.stats;

// Social links with icons
const socialLinks = [
  { key: 'twitter', label: 'X (Twitter)', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>' },
  { key: 'linkedin', label: 'LinkedIn', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>' },
  { key: 'github', label: 'GitHub', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>' },
].filter(s => SITE.social[s.key as keyof typeof SITE.social]);

// Get initials for photo placeholder
const initials = SITE.author.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
---

<Base title="About" description={`Learn more about ${SITE.author.name} and ${SITE.name}.`}>
  <Header />
  
  <main class="about-page">
    <div class="container">
      <!-- Hero Section -->
      <section class="about-hero">
        <div class="author-photo">
          {SITE.images.authorPhoto ? (
            <img src={SITE.images.authorPhoto} alt={SITE.author.name} />
          ) : (
            <div class="photo-placeholder">
              <span>{initials}</span>
            </div>
          )}
        </div>
        <div class="hero-content">
          <h1>Hi, I'm {SITE.author.name}</h1>
          <p class="tagline">{SITE.author.bio}</p>
          <p class="intro">
            I write every article as an enjoyable story that starts with a genuine question, challenges common beliefs, explores multiple perspectives, and follows the reasoning wherever it leads-even when the conclusion is uncomfortable or unexpected.
          </p>
        </div>
      </section>
      
      <!-- Story Section -->
      <section class="story-section">
        <h2>The Story</h2>
        <div class="prose">
          {SITE.author.story.split('\n\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
      
      <!-- Timeline Section -->
      <section class="timeline-section">
        <h2>Journey</h2>
        <div class="timeline">
          {milestones.map((milestone, index) => (
            <div class="timeline-item">
              <div class="timeline-marker">
                <span class="year">{milestone.year}</span>
              </div>
              <div class="timeline-content">
                <h3>{milestone.title}</h3>
                <p>{milestone.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Achievements Section -->
      {stats && (
        <section class="achievements-section">
          <h2>By the Numbers</h2>
          <div class="achievements-grid">
            {stats.monthlyReaders && (
              <div class="achievement">
                <span class="stat-number">{stats.monthlyReaders}</span>
                <span class="stat-label">Monthly Readers</span>
              </div>
            )}
            {stats.articlesWritten && (
              <div class="achievement">
                <span class="stat-number">{stats.articlesWritten}</span>
                <span class="stat-label">Articles Written</span>
              </div>
            )}
            {stats.newsletterSubscribers && (
              <div class="achievement">
                <span class="stat-number">{stats.newsletterSubscribers}</span>
                <span class="stat-label">Newsletter Subscribers</span>
              </div>
            )}
          </div>
        </section>
      )}
      
      <!-- Connect Section -->
      <section class="connect-section">
        <h2>Let's Connect</h2>
        <p>I'd love to hear from you. Reach out on any of these platforms:</p>
        <div class="social-links">
          {socialLinks.map(link => (
            <a href={SITE.social[link.key as keyof typeof SITE.social]} target="_blank" rel="noopener noreferrer" class="social-link">
              <Fragment set:html={link.icon} />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</Base>

<style>
  .about-page {
    min-height: calc(100vh - var(--header-height));
    padding-bottom: var(--space-20);
  }
  
  .container {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  
  /* Hero Section */
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-16) 0 var(--space-12);
    gap: var(--space-8);
  }
  
  @media (min-width: 640px) {
    .about-hero {
      flex-direction: row;
      text-align: left;
      gap: var(--space-12);
    }
  }
  
  .author-photo {
    position: relative;
    flex-shrink: 0;
    width: 176px;
    height: 176px;
    padding: 4px;
    border-radius: var(--radius-full);
    background: conic-gradient(from 200deg, #22d3ee, #60a5fa, #f472b6, #22d3ee);
    transform: rotate(-3deg);
  }

  .author-photo::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: var(--radius-full);
    box-shadow: 0 6px 16px rgba(17, 24, 39, 0.12);
    pointer-events: none;
  }

  .author-photo img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
    transform: rotate(3deg);
  }
  
  .photo-placeholder {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #374151 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transform: rotate(3deg);
  }
  
  .photo-placeholder span {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f9fafb;
  }
  
  .hero-content h1 {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.15;
    overflow-wrap: anywhere;
    word-break: break-word;
    margin-bottom: var(--space-2);
  }
  
  .tagline {
    font-size: var(--text-lg);
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }
  
  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .intro + .intro {
    margin-top: var(--space-4);
  }

  .intro-secondary {
    color: var(--color-text);
  }
  
  /* Sections */
  section {
    padding: var(--space-12) 0;
  }
  
  section + section {
    border-top: 1px solid var(--color-border);
  }
  
  section h2 {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }
  
  /* Story */
  .story-section .prose p {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }
  
  .story-section .prose p:last-child {
    margin-bottom: 0;
  }
  
  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  
  .timeline-item {
    display: flex;
    gap: var(--space-6);
  }
  
  .timeline-marker {
    flex-shrink: 0;
    width: 60px;
    text-align: right;
  }
  
  .year {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }
  
  .timeline-content {
    flex: 1;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-border);
    position: relative;
  }
  
  .timeline-content::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 6px;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
  }
  
  .timeline-content h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  
  .timeline-content p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }
  
  /* Achievements / Stats */
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4);
  }
  
  .achievement {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-md);
  }
  
  .stat-number {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-accent);
  }
  
  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  /* Connect */
  .connect-section p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
  
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  
  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 500;
    transition: all var(--transition-fast);
  }
  
  .social-link:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  
  .social-link svg {
    flex-shrink: 0;
  }
</style>
