---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config/site';

// Build contact links from config
const contactLinks = [
  {
    label: 'Email',
    value: SITE.author.email,
    href: `mailto:${SITE.author.email}`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>'
  },
  SITE.social.twitter && {
    label: 'X (Twitter)',
    value: SITE.social.twitterHandle || '@twitter',
    href: SITE.social.twitter,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>'
  },
  SITE.social.linkedin && {
    label: 'LinkedIn',
    value: SITE.social.linkedin.split('/').pop(),
    href: SITE.social.linkedin,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>'
  },
  SITE.social.github && {
    label: 'GitHub',
    value: '@' + SITE.social.github.split('/').pop(),
    href: SITE.social.github,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>'
  },
].filter(Boolean) as Array<{label: string; value: string; href: string; icon: string}>;
---

<Base title="Contact" description={`Get in touch with ${SITE.author.name}.`}>
  <Header />
  
  <main class="contact-page">
    <div class="container">
      <header class="page-header">
        <h1>Contact</h1>
        <p>Have a question or just want to say hi? I'd love to hear from you.</p>
      </header>
      
      <div class="contact-content">
        <section class="contact-links">
          <h2>Get in Touch</h2>
          <div class="links-list">
            {contactLinks.map(link => (
              <a href={link.href} class="contact-link" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                <div class="link-icon">
                  <Fragment set:html={link.icon} />
                </div>
                <div class="link-info">
                  <span class="link-label">{link.label}</span>
                  <span class="link-value">{link.value}</span>
                </div>
                <svg class="link-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </section>
        
        <section class="response-info">
          <div class="info-card">
            <h3>Response Time</h3>
            <p>I typically respond within 24-48 hours. For urgent matters, DM on Twitter is usually the fastest.</p>
          </div>
          <div class="info-card">
            <h3>Collaborations</h3>
            <p>Open to guest posts, podcast appearances, and speaking opportunities. Let's create something meaningful together.</p>
          </div>
        </section>
      </div>
    </div>
  </main>
  
  <Footer />
</Base>

<style>
  .contact-page {
    min-height: calc(100vh - var(--header-height));
    padding-bottom: var(--space-20);
  }
  
  .container {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  
  .page-header {
    padding: var(--space-16) 0 var(--space-12);
    text-align: center;
  }
  
  .page-header h1 {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  
  .page-header p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
  
  .contact-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  
  /* Contact Links */
  .contact-links h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }
  
  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    transition: all var(--transition-fast);
  }
  
  .contact-link:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  
  .link-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: background-color var(--transition-fast);
  }
  
  .contact-link:hover .link-icon {
    background-color: var(--color-bg-alt);
  }
  
  .link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .link-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }
  
  .contact-link:hover .link-label {
    color: var(--color-text-tertiary);
  }
  
  .link-value {
    font-weight: 500;
    font-size: var(--text-lg);
  }
  
  .link-arrow {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--transition-fast);
  }
  
  .contact-link:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  
  /* Response Info */
  .response-info {
    display: grid;
    gap: var(--space-6);
  }
  
  @media (min-width: 640px) {
    .response-info {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .info-card {
    padding: var(--space-6);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }
  
  .info-card h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  
  .info-card p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
